{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./node_modules/.cache/tsc-node",
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "api/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "src/config/questionPrompt.ts", "src/services/questionFormat.ts", "src/types.ts"]
}
